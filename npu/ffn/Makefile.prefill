SHELL := /bin/bash
PYTHON ?= python3
M ?= 128
K ?= 4096
N ?= 2048
cols ?= 4
build_dir ?= build_prefill

.PHONY: all compile mlir run
all: compile

compile:
	mkdir -p $(build_dir)
	$(PYTHON) w4a16_prefill.py -M $(M) -K $(K) -N $(N) -co $(cols) \
		--xclbin-path $(build_dir)/final.xclbin --insts-path $(build_dir)/insts.bin \
		--pdi-path $(build_dir)/final.pdi

mlir:
	$(PYTHON) w4a16_prefill.py -M $(M) -K $(K) -N $(N) -co $(cols) --emit-mlir

run: compile
	$(PYTHON) run_w4a16_prefill.py --xclbin $(build_dir)/final.xclbin \
		--insts $(build_dir)/insts.bin -M $(M) -K $(K) -N $(N) -co $(cols)
